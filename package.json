{
  "name": "@n3rdw1z4rd/smoke-ui-node-graph",
  "version": "0.1.0",
  "description": "A node graph editor for @n3rdw1z4rd/smoke-ui on @n3rdw1z4rd/core/graph: nodes, wires, widgets, selection, groups, subgraphs, code editing, and evaluation in a worker.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/style.css dist/style.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "smoke-ui",
    "node-graph",
    "node-editor",
    "visual-scripting",
    "dataflow"
  ],
  "author": "n3rdw1z4rd",
  "license": "MIT",
  "peerDependencies": {
    "@n3rdw1z4rd/core": "^0.23.0",
    "@n3rdw1z4rd/smoke-ui": "^0.2.0"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@n3rdw1z4rd/core": "^0.23.0",
    "@n3rdw1z4rd/smoke-ui": "^0.2.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
